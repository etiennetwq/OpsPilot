# Offline by default. Set variables explicitly; no automatic .env loading.
OPSPILOT_LLM=offline
OPSPILOT_API_KEY=
OPSPILOT_API_BASE=https://api.openai.com/v1
OPSPILOT_MODEL=
# Set this only after choosing a provider/model. No implicit paid model.
OPSPILOT_INPUT_USD_PER_MILLION=
OPSPILOT_OUTPUT_USD_PER_MILLION=
# Default offline vectors: deterministic character TF-IDF + SVD.
OPSPILOT_EMBEDDING=lsa
# Optional: pip install -e ".[neural]" then use a downloaded local model path.
OPSPILOT_EMBEDDING_MODEL=

# Dynamic tools: python -m opspilot.cli diagnose "Directory index forbidden" --mode agent
# Or use /setup to keep a DeepSeek key in server memory only.
